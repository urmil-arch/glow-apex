# ============================================================
# BuyRealViews — Backend Environment Variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# ============================================================

# ── App URLs ────────────────────────────────────────────────
# For IP-based deployment (before Cloudflare):
BACKEND_BASE_URL=http://YOUR_SERVER_IP/api
FRONTEND_ORIGIN=http://YOUR_SERVER_IP

# For Cloudflare + custom domain (after DNS is configured):
# BACKEND_BASE_URL=https://buyrealviews.com/api
# FRONTEND_ORIGIN=https://buyrealviews.com

# Glow Apex checkout portal (D2)
GLOWAPEX_ORIGIN=http://YOUR_SERVER_IP:3001
# After Cloudflare:
# GLOWAPEX_ORIGIN=https://glowapex.com

# Stores a user may be returned to after paying (comma-separated). Validated against the
# return_origin sent at checkout to prevent open-redirect. FRONTEND_ORIGIN is always allowed.
ALLOWED_RETURN_ORIGINS=
# After Cloudflare:
# ALLOWED_RETURN_ORIGINS=https://buyrealviews.com,https://buyrealsubscribers.com

# Cryptomus inline (on-store) payment — single coin/network at launch
CRYPTOMUS_DEFAULT_CURRENCY=USDT
CRYPTOMUS_DEFAULT_NETWORK=tron

# ── Infrastructure ───────────────────────────────────────────
# These are overridden by docker-compose.prod.yml — leave as-is.
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=buyrealviews
REDIS_URL=redis://redis:6379

# ── JWT ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_64_HEX_CHAR_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Provider API Key Encryption ──────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_ENCRYPTION_SECRET=REPLACE_WITH_64_HEX_CHAR_SECRET

# ── SMTP (Gmail recommended) ──────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-gmail@gmail.com
CONTACT_OWNER_EMAIL=your-gmail@gmail.com

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── SMM Panel ────────────────────────────────────────────────
POSTLIKES_API_KEY=your-postlikes-api-key

# ── Stripe ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Razorpay ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ── Cashfree ─────────────────────────────────────────────────
CASHFREE_CLIENT_ID=your-cashfree-client-id
CASHFREE_CLIENT_SECRET=your-cashfree-client-secret
CASHFREE_BASE_URL=https://api.cashfree.com/pg

# ── Cryptomus ────────────────────────────────────────────────
CRYPTOMUS_MERCHANT_ID=your-cryptomus-merchant-id
CRYPTOMUS_API_KEY=your-cryptomus-api-key

# ── Payeer ───────────────────────────────────────────────────
PAYEER_MERCHANT_ID=your-payeer-merchant-id
PAYEER_SECRET_KEY=your-payeer-secret-key
PAYEER_ENCRYPTION_KEY=your-payeer-encryption-key
